{
  "agentGuidance": false,
  "globalPassThroughEnv": ["TMPDIR", "HANDLINE_AGENT"],
  "cacheDir": ".turbo/cache",
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "test": {
      "dependsOn": ["^test"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "inputs": [
        "src/**",
        "test/**",
        "ui/**",
        "*.ts",
        "*.tsx",
        "eslint.config.js",
        "tsconfig*.json",
        "$TURBO_ROOT$/packages/config/**"
      ]
    }
  }
}
