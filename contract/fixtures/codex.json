{
 "fixtures": [
  {
   "name": "accounts.discover.lists_the_logins_found",
   "spec": "accounts.discover",
   "as": "founder",
   "about": "The logins already on this Mac, each with its folder, whether it is logged in and whether account.adopt takes it.",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "accounts.discover",
      "params": {}
     },
     "result": {
      "found": {
       "$type": "array"
      }
     }
    }
   ]
  },
  {
   "name": "accounts.discover.an_agent_session_is_refused",
   "spec": "accounts.discover",
   "as": "agent",
   "about": "Only the owner reads what logins are on the Mac.",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "accounts.discover",
      "params": {}
     },
     "error": {
      "code": -32002,
      "data": {
       "code": "refused",
       "gate": "role"
      }
     }
    }
   ]
  },
  {
   "name": "account.adopt.a_claude_login_is_bad_request",
   "spec": "account.adopt",
   "as": "founder",
   "about": "A Claude login is keyed by its config folder and cannot be shared: the vendor is bad_request.",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "account.adopt",
      "params": {
       "vendor": "claude",
       "source": "~/.claude",
       "account": "conf.adopt-claude",
       "request_id": "conf-ad-1"
      }
     },
     "error": {
      "code": -32602,
      "data": {
       "code": "bad_request",
       "field": "vendor"
      }
     }
    }
   ]
  },
  {
   "name": "account.adopt.a_source_not_found_is_not_found",
   "spec": "account.adopt",
   "as": "founder",
   "about": "A source accounts.discover did not answer is not_found, what source.",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "account.adopt",
      "params": {
       "vendor": "codex",
       "source": "/nowhere/.codex",
       "account": "conf.adopt-none",
       "request_id": "conf-ad-2"
      }
     },
     "error": {
      "code": -32001,
      "data": {
       "code": "not_found",
       "what": "source"
      }
     }
    }
   ]
  },
