{
 "fixtures": [
  {
   "name": "agent.get.view_fire_context",
   "spec": "agent.get",
   "about": "An agent whose triggers apply and whose context is at its limit: fire is `context`, in agent.get and in agents.list. Needs --var view_fire_agent.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "agent.get",
      "params": {
       "agent": "{{view_fire_agent}}"
      }
     },
     "result": {
      "name": "{{view_fire_agent}}",
      "fire": "context"
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "agents.list",
      "params": {}
     },
     "result": {
      "agents": {
       "$contains": {
        "name": "{{view_fire_agent}}",
        "fire": "context"
       }
      }
     }
    }
   ]
  },
