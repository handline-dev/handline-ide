       "body": "build it; done is it built and tested",
       "time_box": "1h",
       "request_id": "conf-ma-1"
      }
     },
     "result": {
      "accepted": true,
      "task": {
       "$save": "tid"
      }
     },
     "on": "boss"
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
