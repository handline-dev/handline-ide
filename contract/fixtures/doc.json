  {
   "name": "doc.push.every_editor_gets_the_updates",
   "spec": "doc.push",
   "about": "A push on the current version is taken: the version goes up by one per update, and every connection that has the doc open, the pusher too, gets doc_changed with the updates, each by human. The second update puts the text back.",
   "as": "founder",
   "with": {
    "b": "founder"
   },
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {},
     "on": "b"
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "doc.open",
      "params": {
       "agent": "{{files_agent}}",
       "path": "notes/todo.md"
      }
     },
     "result": {
      "doc": {
       "$save": "doc",
       "$type": "string"
      },
      "version": 0,
      "text": "x"
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "doc.open",
      "params": {
       "agent": "{{files_agent}}",
       "path": "notes/todo.md"
      }
     },
     "result": {
      "doc": {
       "$save": "doc_b",
       "$type": "string"
      },
      "version": 0,
      "text": "x"
     },
     "on": "b"
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "doc.push",
      "params": {
       "agent": "{{files_agent}}",
       "path": "notes/todo.md",
       "doc": "{{doc}}",
       "version": 0,
       "updates": [
        {
         "client": "conf-a",
         "changes": [
          1,
          [
           0,
           "y"
          ]
         ]
        }
       ],
       "request_id": "conf-doc-1"
      }
     },
     "result": {
      "version": 1
     },
     "notices": [
      {
       "jsonrpc": "2.0",
       "method": "doc_changed",
       "params": {
        "agent": "{{files_agent}}",
        "path": "notes/todo.md",
        "doc": "{{doc}}",
        "version": 1,
        "updates": [
         {
          "client": "conf-a",
          "changes": [
           1,
           [
            0,
            "y"
           ]
          ],
          "by": "human"
         }
        ]
       }
      }
     ]
    },
    {
     "on": "b",
     "notices": [
      {
       "jsonrpc": "2.0",
       "method": "doc_changed",
       "params": {
        "agent": "{{files_agent}}",
        "path": "notes/todo.md",
        "doc": "{{doc}}",
        "version": 1,
        "updates": [
         {
          "client": "conf-a",
          "changes": [
           1,
           [
            0,
            "y"
           ]
          ],
          "by": "human"
         }
        ]
       }
      }
     ]
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "doc.push",
      "params": {
       "agent": "{{files_agent}}",
       "path": "notes/todo.md",
       "doc": "{{doc}}",
       "version": 1,
       "updates": [
        {
         "client": "conf-a",
         "changes": [
          1,
          [
           1
          ]
         ]
        }
       ],
       "request_id": "conf-doc-2"
      }
     },
     "result": {
      "version": 2
     },
     "notices": [
      {
       "jsonrpc": "2.0",
       "method": "doc_changed",
       "params": {
        "agent": "{{files_agent}}",
        "path": "notes/todo.md",
        "doc": "{{doc}}",
        "version": 2,
        "updates": [
         {
          "client": "conf-a",
          "changes": [
           1,
           [
            1
           ]
          ],
          "by": "human"
         }
        ]
       }
      }
     ]
    }
   ]
