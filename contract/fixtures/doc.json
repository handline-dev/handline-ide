{
 "fixtures": [
  {
   "name": "doc.open.the_text_at_version_0",
   "spec": "doc.open",
   "about": "A .md file opens as a doc at version 0 with the file's text (the seed's notes/todo.md holds x); opening it again on the connection gives the same doc and nothing to pull; closing it is an empty answer, and closing it again is not an error.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "doc.open",
      "params": {
       "agent": "{{files_agent}}",
       "path": "notes/todo.md"
      }
     },
     "result": {
      "doc": {
       "$save": "doc",
       "$type": "string"
      },
      "version": 0,
      "text": "x"
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 5,
      "method": "doc.open",
      "params": {
       "agent": "{{files_agent}}",
       "path": "notes/todo.md"
      }
     },
     "result": {
      "doc": "{{doc}}",
      "version": 0,
      "text": "x"
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 6,
      "method": "doc.pull",
      "params": {
       "agent": "{{files_agent}}",
       "path": "notes/todo.md",
       "doc": "{{doc}}",
       "version": 0
      }
     },
     "result": {
      "version": 0,
      "updates": []
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "doc.close",
      "params": {
       "agent": "{{files_agent}}",
       "path": "notes/todo.md"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "doc.close",
      "params": {
       "agent": "{{files_agent}}",
       "path": "notes/todo.md"
      }
     },
     "result": {}
    }
   ]
  },
  {
   "name": "doc.open.what_is_not_an_open_md_file",
   "spec": "doc.open",
   "about": "Not .md, a .. part or a missing file: bad_request naming path, or not_found. An agent with no worktree is not_found.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
