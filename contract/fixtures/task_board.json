      "id": 2,
      "method": "task.new",
      "params": {
       "owner": "human",
       "title": "board todo",
       "body": "b",
       "request_id": "conf-board-todo"
      }
     },
     "result": {
      "accepted": true,
      "task": {
       "$save": "made"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "task.board",
      "params": {}
     },
     "result": {
      "mine": {
       "$contains": {
        "task": {
         "id": "{{made}}",
         "to": "human"
        },
        "holder": "human",
        "now": {
         "kind": "held",
         "agents": [
          "human"
         ],
         "tasks": []
        }
       }
      },
      "reports": {
       "$type": "array"
      }
     }
    }
   ]
  },
