{
 "fixtures": [
  {
   "name": "attachment.folder.an_agent_session_is_refused",
   "spec": "attachment.folder",
   "about": "An agent may not open a folder, gate role, as for attachment.put.",
   "as": "agent",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "attachment.folder",
      "params": {
       "name": "notes",
       "request_id": "conf-fo-1"
      }
     },
     "error": {
      "code": -32002,
      "data": {
       "code": "refused",
       "gate": "role"
      }
     }
    }
   ]
  },
