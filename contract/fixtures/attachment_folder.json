  {
   "name": "attachment.folder.files_fill_it_and_a_message_names_it",
   "spec": "attachment.folder",
   "about": "Files put with folder and rel_path fill one folder attachment: its bytes are their sum and files their count; a message names the folder as one attachment.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "attachment.folder",
      "params": {
       "name": "notes",
       "request_id": "conf-fo-3"
      }
     },
     "result": {
      "accepted": true,
      "attachment": {
       "id": {
        "$regex": "^[0-9a-f]{16}$",
        "$save": "dir"
       },
       "name": "notes",
       "mime": "inode/directory",
       "bytes": 0,
       "files": 0
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "attachment.put",
      "params": {
       "name": "a.md",
       "mime": "text/plain",
       "bytes": 6,
       "data": "YWxwaGEK",
       "request_id": "conf-fo-4",
       "folder": "{{dir}}",
       "rel_path": "a.md"
      }
     },
     "result": {
      "received": 6,
      "attachment": {
       "id": "{{dir}}",
       "mime": "inode/directory",
       "bytes": 6,
       "files": 1
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "attachment.put",
      "params": {
       "name": "b.md",
       "mime": "text/plain",
       "bytes": 6,
       "data": "YmV0YSEK",
       "request_id": "conf-fo-5",
       "folder": "{{dir}}",
       "rel_path": "sub/b.md"
      }
     },
     "result": {
      "received": 6,
      "attachment": {
       "id": "{{dir}}",
       "mime": "inode/directory",
       "bytes": 12,
       "files": 2
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 5,
      "method": "chat.send",
      "params": {
       "agent": "{{ask_agent}}",
       "body": "the notes folder",
       "attachments": [
        "{{dir}}"
       ],
       "request_id": "conf-fo-6"
      }
     },
     "result": {
      "accepted": true,
      "request": {
       "$save": "rid"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 6,
      "method": "chat.messages",
      "params": {
       "agent": "{{ask_agent}}",
       "scope": "mine"
      }
     },
     "result": {
      "messages": {
       "$contains": {
        "id": "{{rid}}",
        "attachments": [
         {
          "id": "{{dir}}",
          "name": "notes",
          "mime": "inode/directory",
          "bytes": 12,
          "files": 2
         }
        ]
       }
      }
     }
    }
   ]
  },
