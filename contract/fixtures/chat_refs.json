  {
   "name": "chat.send.refs_with_a_task_are_bad_request",
   "spec": "chat.send",
   "about": "Refs go with a message, not a task: bad_request.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "chat.send",
      "params": {
       "agent": "{{ask_agent}}",
       "body": "see these",
       "refs": [
        "/tmp"
       ],
       "request_id": "conf-rf-4",
       "task": {
        "title": "look"
       }
      }
