  {
   "name": "chat.send.a_ref_is_kept_with_the_message",
   "spec": "chat.send",
   "about": "With chat_refs_need_grant off a ref is sent as it is, and ChatMessage.refs lists it. request.read gives it too, with whether it was a folder.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "chat.send",
      "params": {
       "agent": "{{ask_agent}}",
       "body": "",
       "refs": [
        "/tmp"
       ],
       "request_id": "conf-rf-6"
      }
     },
     "result": {
      "accepted": true,
      "request": {
       "$save": "rid"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "chat.messages",
      "params": {
       "agent": "{{ask_agent}}",
       "scope": "mine"
      }
     },
     "result": {
      "messages": {
       "$contains": {
        "id": "{{rid}}",
        "refs": [
         "/tmp"
        ]
       }
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "request.read",
      "params": {
       "id": "{{rid}}"
      }
     },
     "result": {
      "refs": [
       {
        "path": "/tmp",
        "folder": true
       }
      ]
     }
    }
   ]
  },
