{
 "fixtures": [
  {
   "name": "chat.send.a_relative_ref_is_bad_request",
   "spec": "chat.send",
   "about": "A ref must be absolute: bad_request, field refs.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "chat.send",
      "params": {
       "agent": "{{ask_agent}}",
       "body": "see these",
       "refs": [
        "notes/a.md"
       ],
       "request_id": "conf-rf-2"
      }
     },
     "error": {
      "code": {
       "$oneOf": [
        -32600,
        -32602
       ]
      },
      "data": {
       "code": "bad_request",
       "field": "refs"
      }
     }
    }
   ]
  },
