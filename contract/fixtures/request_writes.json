{
 "fixtures": [
  {
   "name": "request.withdraw.an_unknown_request_is_said_not_raised",
   "spec": "request.withdraw",
   "about": "A request that does not exist is a reply with ok false and the reason.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "request.withdraw",
      "params": {
       "id": 999999999,
       "request_id": "conf-rw-1"
      }
     },
     "result": {
      "ok": false,
      "said": "request 999999999 does not exist"
     }
    }
   ]
  },
