    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 8,
      "method": "requests.pending",
      "params": {}
     },
     "result": {
      "counts": {
       "answer": "{{c0}}"
      }
     },
     "on": "boss"
    }
   ]
