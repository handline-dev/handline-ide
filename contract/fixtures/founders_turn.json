    {
     "send": {
      "jsonrpc": "2.0",
      "id": 6,
      "method": "requests.pending",
      "params": {}
     },
     "result": {
      "answer": {
       "$contains": {
        "task": "{{tid}}"
       }
      },
      "counts": {
       "answer": {
        "$next": "c0"
       }
      }
     },
     "on": "boss"
    },
    {
