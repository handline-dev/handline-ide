 "fixtures": [
  {
   "name": "requests.pending.a_turn_stays_through_task_seen_and_leaves_when_passed",
   "spec": "requests.pending",
   "as": "agent",
   "with": {
    "boss": "founder"
   },
   "about": "A task with the founder on top is one row and one more in the count; reading it changes nothing; passing it removes it.",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1
      }
     },
     "result": {
      "caller": {
       "name": {
        "$save": "me"
       }
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {},
     "on": "boss"
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 9,
      "method": "requests.pending",
      "params": {}
     },
     "result": {
      "counts": {
       "answer": {
        "$type": "integer",
        "$save": "c0"
       },
       "unseen_results": {
        "$type": "integer",
        "$save": "u0"
       }
      }
     },
     "on": "boss"
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "task.new",
      "params": {
       "owner": "{{me}}",
       "title": "a turn task",
       "body": "build it; done is it built",
       "time_box": "1h",
       "request_id": "conf-ft-turn task-new"
      }
     },
     "result": {
      "accepted": true,
      "task": {
       "$save": "tid"
      }
     },
     "on": "boss"
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "task.comment.add",
      "params": {
       "task": "{{tid}}",
       "text": "pick one",
       "turn": "human",
       "request_id": "conf-ft-turn-push"
      }
     },
     "result": {
      "accepted": true
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "requests.pending",
      "params": {}
     },
     "result": {
      "answer": {
       "$contains": {
        "task": "{{tid}}",
        "kind": "decide",
        "source": "task",
        "agent": "{{me}}",
        "ask": "pick one",
        "warning": null
       }
      },
      "counts": {
       "answer": {
        "$next": "c0"
       }
      }
     },
     "on": "boss"
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 5,
      "method": "task.seen",
