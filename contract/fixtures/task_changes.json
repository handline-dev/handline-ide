{
 "fixtures": [
  {
   "name": "task.changes.unknown_task_is_not_found",
   "spec": "task.changes",
   "about": "The changes of a task nobody opened are not_found, what task.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "task.changes",
      "params": {
       "task": 999999
      }
     },
     "error": {
      "code": -32001,
      "data": {
       "code": "not_found",
       "what": "task"
      }
     }
    }
   ]
  },
